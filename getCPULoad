get_cpu_stats() {
    # 1. Ambil Sampel Pertama
    read -r _ u1 n1 s1 i1 w1 ir1 si1 st1 _ < /proc/stat

    cores1=""
    while read -r line; do
        case "$line" in
            cpu[0-9]*) cores1="${cores1}${line}\n" ;;
            *) [ -n "$cores1" ] && break ;;
        esac
    done < /proc/stat

    sleep 1

    # 2. Ambil Sampel Kedua
    read -r _ u2 n2 s2 i2 w2 ir2 si2 st2 _ < /proc/stat

    cores2=""
    while read -r line; do
        case "$line" in
            cpu[0-9]*) cores2="${cores2}${line}\n" ;;
            *) [ -n "$cores2" ] && break ;;
        esac
    done < /proc/stat

    # --- 3. Hitung Overall CPU Usage ---
    t1_all=$((u1 + n1 + s1 + i1 + w1 + ir1 + si1 + st1))
    i1_all=$((i1 + w1))

    t2_all=$((u2 + n2 + s2 + i2 + w2 + ir2 + si2 + st2))
    i2_all=$((i2 + w2))

    td_all=$((t2_all - t1_all))
    id_all=$((i2_all - i1_all))

    if [ $td_all -gt 0 ]; then
        overall=$(( (td_all - id_all) * 100 / td_all ))
    else
        overall=0
    fi

    # --- 4. Tentukan Direktori Temporary Aman di Android ---
    if [ -d /dev/tmp ]; then
        TMP_OUT="/dev/tmp/.cpu_out"
    else
        TMP_OUT="/data/local/tmp/.cpu_out"
    fi

    # --- 5. Hitung Per-Core Usage & Frequency ---
    cores_array=""
    freqs_array=""

    printf "%b" "$cores1" | while read -r c_name u1 n1 s1 i1 w1 ir1 si1 st1 _; do
        [ -z "$c_name" ] && continue

        line2=$(printf "%b" "$cores2" | grep "^${c_name} ")
        
        set -- $line2
        u2=$2; n2=$3; s2=$4; i2=$5; w2=$6; ir2=$7; si2=$8; st2=$9

        t1=$((u1 + n1 + s1 + i1 + w1 + ir1 + si1 + st1))
        id1=$((i1 + w1))

        t2=$((u2 + n2 + s2 + i2 + w2 + ir2 + si2 + st2))
        id2=$((i2 + w2))

        td=$((t2 - t1))
        id=$((id2 - id1))

        if [ $td -gt 0 ]; then
            usage=$(( (td - id) * 100 / td ))
        else
            usage=0
        fi

        core_num="${c_name#cpu}"
        freq_file="/sys/devices/system/cpu/cpu${core_num}/cpufreq/scaling_cur_freq"

        if [ -f "$freq_file" ]; then
            read -r freq_khz < "$freq_file"
            freq=$((freq_khz / 1000))
        else
            freq=0
        fi

        if [ -z "$cores_array" ]; then
            cores_array="$usage"
            freqs_array="$freq"
        else
            cores_array="${cores_array}, ${usage}"
            freqs_array="${freqs_array}, ${freq}"
        fi

        # Simpan ke TMP_OUT aman
        echo "$cores_array|$freqs_array" > "$TMP_OUT"
    done

    # Baca hasil akhir
    if [ -f "$TMP_OUT" ]; then
        IFS='|' read -r cores_array freqs_array < "$TMP_OUT"
        rm -f "$TMP_OUT"
    fi

    # --- 6. Output JSON Object ---
    cat <<EOF
{
  "cpu": ${overall},
  "cpuCore": [${cores_array}],
  "cpuFreq": [${freqs_array}]
}
EOF
}



#!/system/bin/sh

get_cpu_stats_pretty() {
    json_data=$(get_cpu_stats)

    overall=$(echo "$json_data" | grep '"cpu":' | awk -F': ' '{print $2}' | tr -d ', ')

    # Ambil elemen array dan jadikan baris
    cores_clean=$(echo "$json_data" | grep '"cpuCore":' | sed 's/.*\[\(.*\)\].*/\1/' | tr ',' ' ')
    freqs_clean=$(echo "$json_data" | grep '"cpuFreq":' | sed 's/.*\[\(.*\)\].*/\1/' | tr ',' ' ')

    echo "=========================="
    echo "📊 CPU STATS"
    echo "=========================="
    echo "CPU: ${overall}%"
    echo "--------------------------"

    # Convert string ke positional parameters
    set -- $cores_clean
    core_arr=("$@")

    set -- $freqs_clean
    freq_arr=("$@")

    # Iterasi berdasarkan panjang array
    for i in $(seq 0 $((${#core_arr[@]} - 1))); do
        u="${core_arr[$i]}"
        f="${freq_arr[$i]}"

        if [ -z "$f" ] || [ "$f" -eq 0 ]; then
            echo "CPU${i}: ${u}% ( OFF )"
        else
            echo "CPU${i}: ${u}% ( ${f}MHz )"
        fi
    done
    echo "=========================="
}
get_cpu_stats_pretty
