get_cpu_stats() {
    # 1. Ambil sampel pertama
    stat1=$(cat /proc/stat)
    
    # Jeda 1 detik untuk sampel kalkulasi persentase
    sleep 1

    # 2. Ambil sampel kedua
    stat2=$(cat /proc/stat)

    # --- Hitung Usage Overall ---
    l1_all=$(echo "$stat1" | grep "^cpu ")
    l2_all=$(echo "$stat2" | grep "^cpu ")

    t1_all=$(echo "$l1_all" | awk '{sum=0; for(i=2;i<=9;i++) sum+=$i; print sum}')
    i1_all=$(echo "$l1_all" | awk '{print $5+$6}')

    t2_all=$(echo "$l2_all" | awk '{sum=0; for(i=2;i<=9;i++) sum+=$i; print sum}')
    i2_all=$(echo "$l2_all" | awk '{print $5+$6}')

    td_all=$((t2_all - t1_all))
    id_all=$((i2_all - i1_all))

    if [ $td_all -gt 0 ]; then
        overall=$(( (td_all - id_all) * 100 / td_all ))
    else
        overall=0
    fi

    # --- Hitung Usage & Frequency Per-Core ---
    cores_array=""
    freqs_array=""

    # Tampung sementara hasil iterasi ke file tmp agar tidak hilang akibat subshell loop
    tmp_file="/sdcard/.cpu_tmp_data"
    
    echo "$stat1" | grep "^cpu[0-9]" | while read -r line1; do
        c_name=$(echo "$line1" | awk '{print $1}')
        line2=$(echo "$stat2" | grep "^${c_name} ")

        # Hitung Persentase Core
        t1=$(echo "$line1" | awk '{sum=0; for(i=2;i<=9;i++) sum+=$i; print sum}')
        i1=$(echo "$line1" | awk '{print $5+$6}')

        t2=$(echo "$line2" | awk '{sum=0; for(i=2;i<=9;i++) sum+=$i; print sum}')
        i2=$(echo "$line2" | awk '{print $5+$6}')

        td=$((t2 - t1))
        id=$((i2 - i1))

        if [ $td -gt 0 ]; then
            usage=$(( (td - id) * 100 / td ))
        else
            usage=0
        fi

        # Ambil Frekuensi Core (dalam MHz)
        core_num=$(echo "$c_name" | tr -d 'cpu')
        freq_file="/sys/devices/system/cpu/cpu${core_num}/cpufreq/scaling_cur_freq"
        
        if [ -f "$freq_file" ]; then
            freq_khz=$(cat "$freq_file")
            freq=$((freq_khz / 1000))
        else
            freq=0 # 0 jika core offline / deep sleep
        fi

        echo "$usage $freq"
    done > "$tmp_file"

    # Menyusun Array JSON dari hasil tmp
    while read -r u_val f_val; do
        if [ -z "$cores_array" ]; then
            cores_array="$u_val"
            freqs_array="$f_val"
        else
            cores_array="${cores_array}, ${u_val}"
            freqs_array="${freqs_array}, ${f_val}"
        fi
    done < "$tmp_file"
    
    rm -f "$tmp_file"

    # --- Output JSON Object ---
    cat <<EOF
{
  "cpu": ${overall},
  "cpuCore": [${cores_array}],
  "cpuFreq": [${freqs_array}]
}
EOF
}



#!/system/bin/sh

get_cpu_stats_pretty() {
    json_data=$(get_cpu_stats)

    overall=$(echo "$json_data" | grep '"cpu":' | awk -F': ' '{print $2}' | tr -d ', ')

    # Ambil elemen array dan jadikan baris
    cores_clean=$(echo "$json_data" | grep '"cpuCore":' | sed 's/.*\[\(.*\)\].*/\1/' | tr ',' ' ')
    freqs_clean=$(echo "$json_data" | grep '"cpuFreq":' | sed 's/.*\[\(.*\)\].*/\1/' | tr ',' ' ')

    echo "=========================="
    echo "📊 CPU STATS"
    echo "=========================="
    echo "CPU: ${overall}%"
    echo "--------------------------"

    # Convert string ke positional parameters
    set -- $cores_clean
    core_arr=("$@")

    set -- $freqs_clean
    freq_arr=("$@")

    # Iterasi berdasarkan panjang array
    for i in $(seq 0 $((${#core_arr[@]} - 1))); do
        u="${core_arr[$i]}"
        f="${freq_arr[$i]}"

        if [ -z "$f" ] || [ "$f" -eq 0 ]; then
            echo "CPU${i}: ${u}% ( OFF )"
        else
            echo "CPU${i}: ${u}% ( ${f}MHz )"
        fi
    done
    echo "=========================="
}
get_cpu_stats_pretty
