# 1. Verifikasi Akses Root
if [ "$(id -u)" -ne 0 ]; then
    echo "[!] Error: Script ini memerlukan akses Root (su)."
    exit 1
fi

echo "=========================================="
echo "      CPU Governor Menu Selector         "
echo "=========================================="

# 2. Deteksi Total Core CPU
TOTAL_CORES=$(ls -d /sys/devices/system/cpu/cpu[0-9]* 2>/dev/null | wc -l)

if [ "$TOTAL_CORES" -eq 0 ]; then
    echo "[!] Error: Gagal mendeteksi core CPU."
    exit 1
fi

echo "[i] Total Core terdeteksi: $TOTAL_CORES Core"

# 3. Baca Governor yang Didukung oleh Kernel
AVAIL_GOV_FILE="/sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors"

if [ ! -f "$AVAIL_GOV_FILE" ]; then
    AVAIL_GOV_FILE=$(ls /sys/devices/system/cpu/cpu*/cpufreq/scaling_available_governors 2>/dev/null | head -n 1)
fi

if [ -z "$AVAIL_GOV_FILE" ] || [ ! -f "$AVAIL_GOV_FILE" ]; then
    echo "[!] Error: Gagal membaca daftar governor dari kernel."
    exit 1
fi

GOV_LIST=$(cat "$AVAIL_GOV_FILE" 2>/dev/null)

echo "------------------------------------------"
echo "[?] Daftar Governor yang didukung kernel:"
echo "------------------------------------------"

# Tampilkan menu bernomor
count=1
for gov in $GOV_LIST; do
    echo "  [$count] $gov"
    eval "GOV_OPT_$count=\"$gov\""
    count=$((count + 1))
done

MAX_OPT=$((count - 1))

echo "------------------------------------------"

# 4. PAUSE: Menunggu User Memasukkan Pilihan Nomor (Kompatibel mksh)
CHOICE=""
while true; do
    echo -n ">> Masukkan nomor pilihan [1-$MAX_OPT]: "
    read CHOICE
    
    # Validasi input (harus berupa angka dan sesuai rentang opsi)
    case "$CHOICE" in
        ''|*[!0-9]*)
            echo "[!] Input tidak valid! Harap masukkan angka."
            ;;
        *)
            if [ "$CHOICE" -ge 1 ] && [ "$CHOICE" -le "$MAX_OPT" ]; then
                break
            else
                echo "[!] Pilihan nomor $CHOICE tidak ada dalam menu!"
            fi
            ;;
    esac
done

# Ambil nama governor dari nomor pilihan
eval "TARGET_GOV=\$GOV_OPT_$CHOICE"

echo "------------------------------------------"
echo "[+] Memproses penerapan governor: $TARGET_GOV ..."
echo "------------------------------------------"

# 5. PENERAPAN: Mengubah Governor di Semua Core
SUCCESS_COUNT=0
i=0

while [ $i -lt $TOTAL_CORES ]; do
    CORE_PATH="/sys/devices/system/cpu/cpu$i/cpufreq"
    
    if [ -d "$CORE_PATH" ]; then
        GOV_FILE="$CORE_PATH/scaling_governor"
        
        if [ -f "$GOV_FILE" ]; then
            echo "$TARGET_GOV" > "$GOV_FILE" 2>/dev/null
            
            # Verifikasi status
            CURRENT_GOV=$(cat "$GOV_FILE" 2>/dev/null)
            if [ "$CURRENT_GOV" = "$TARGET_GOV" ]; then
                echo "[+] CPU $i: Berhasil -> $CURRENT_GOV"
                SUCCESS_COUNT=$((SUCCESS_COUNT + 1))
            else
                echo "[-] CPU $i: Gagal diubah."
            fi
        fi
    fi
    i=$((i + 1))
done

echo "------------------------------------------"
echo "[✓] Selesai! Total $SUCCESS_COUNT/$TOTAL_CORES core diset ke '$TARGET_GOV'."
echo "=========================================="
